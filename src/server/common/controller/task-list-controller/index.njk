{% from "govuk/components/task-list/macro.njk" import govukTaskList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% extends 'layouts/page.njk' %}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        <h1 class="govuk-heading-l">{{ heading }}</h1>
        {% set buttonClass = "" %}
        {% if incompleteTasks > 0 %}
          {% set buttonClass = "govuk-button--secondary" %}
          <p>
            <span data="test-id-task-to-complete-count">
              {{
                translate(
                  'common.taskList.progress.incomplete',
                  'You have ' ~ incompleteTasks ~ ' out of ' ~ gdsTasks.length ~ ' sections left to complete.',
                  { remaining: incompleteTasks, total: gdsTasks.length }
                )
              }}
            </span>
          </p>
        {% else %}
          <p data="test-id-task-to-complete-count">
            {{ translate('common.taskList.progress.allSectionsComplete', 'You have completed all sections.') }}
          </p>
        {% endif %}
        {{
          govukTaskList({
            idPrefix: "task-list",
            items: gdsTasks
          })
        }}
        <form method="POST">
          <input type="hidden" name="crumb" value="{{ crumb }}" /> {{
            govukButton({
                text: buttonText,
                classes: buttonClass
            })
          }}
        </form>
      </div>
    </div>
  </div>
{% endblock %}
