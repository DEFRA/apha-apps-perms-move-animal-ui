{% from "govuk/components/button/macro.njk" import govukButton %}
{%
  extends
  'layouts/page.njk'
%}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        <div class="govuk-!-margin-top-0 govuk-!-margin-bottom-8">
          <h1 class="govuk-heading-l">{{ heading }}</h1>
        </div>
        <p class="govuk-body">
          {{
            translate(
              'tb.home.intro',
              'Use this service to apply for a TB movement licence. You must have a licence before moving cattle onto or off a farm or premises with TB restrictions.'
            )
          }}
        </p>
        <p class="govuk-body">
          {{
            translate(
              'tb.home.checkExistingLicence',
              'Check if APHA has already sent you a TB movement licence before you apply.'
            )
          }}
        </p>
        <h3 class="govuk-heading-m">
          {{ translate('tb.home.whoCanUseThisService', 'Who can use this service') }}
        </h3>
        <p class="govuk-body">
          {{ translate('tb.home.youCanUseThisService', 'You can use this service to apply for a licence if you are moving cattle:') }}
        </p>
        <ul class="govuk-list govuk-list--bullet">
          <li>
            {{ translate('tb.home.movingCattleReasons.reason-1', 'from an unrestricted farm or market to a TB restricted farm or premises') }}
          </li>
          <li>
            {{ translate('tb.home.movingCattleReasons.reason-2', 'from a TB restricted farm or premises to:') }}
            <ul class="govuk-list govuk-list--bullet circle">
              <li>
                {{ translate('tb.home.movingCattleReasons.reason-2-options.option-1', 'a TB restricted farm or premises') }}
              </li>
              <li>
                {{ translate('tb.home.movingCattleReasons.reason-2-options.option-2', 'an approved finishing unit (AFU), including enhanced with grazing (AFUE)') }}
              </li>
              <li>
                {{ translate('tb.home.movingCattleReasons.reason-2-options.option-3', 'slaughter or a TB slaughter gathering (red market), unless covered by a general licence') }}
              </li>
              <li>
                {{ translate('tb.home.movingCattleReasons.reason-2-options.option-4', 'a dedicated TB sale (orange market)') }}
              </li>
            </ul>
          </li>
          <li>
            {{ translate('tb.home.movingCattleReasons.reason-3', 'from an AFU (including AFUE) to an AFU (including AFUE)') }}
          </li>
        </ul>
        <h3 class="govuk-heading-m">
          {{ translate('tb.home.whenYouDoNotNeedThisService', 'When you do not need this service') }}
        </h3>
        <p class="govuk-body">
          {{ translate('tb.home.generalLicenceNotice', 'You don’t need to apply if a general licence already allows the movement.') }}
        </p>
        <p class="govuk-body">
          {{ translate('tb.home.generalLicenceCheck', 'Check the general licence APHA sent you when your herd was placed under TB restriction. A general licence will allow you to move cattle:') }}
        </p>
        <ul class="govuk-list govuk-list--bullet">
          <li>
            {{ translate('tb.home.generalLicenceMovements.movement-1', 'direct to slaughter') }}
          </li>
          <li>
            {{ translate('tb.home.generalLicenceMovements.movement-2', 'via a TB slaughter gathering (red market) if issued after 30 September 2024') }}
          </li>
        </ul>
        <h3 class="govuk-heading-m">
          {{ translate('tb.home.movingBetweenRestrictedPremises', 'Moving cattle between TB restricted farms or premises') }}
        </h3>
        <p class="govuk-body">
          {{ translate('tb.home.movingBetweenRestrictedPremisesIntro', 'If cattle are moving from a TB restricted farm or premises to another TB restricted farm or premises, the destination farm or premises must apply for the licence. This is because we need details about their TB biosecurity procedures.') }}
        </p>
        <p class="govuk-body">
          {{ translate('tb.home.cannotApplyIntro', 'If the destination farm or premises cannot apply, use') }}
          <a
            href="https://www.gov.uk/government/publications/tb-movement-licence-moving-animals-between-restricted-premises-in-england"
          >
            {{ translate('tb.home.cannotApplyLinkText', 'this application form') }}</a
          >
          {{ translate('tb.home.cannotApplySuffix', 'instead.') }}
        </p>
        <h3 class="govuk-heading-m">
          {{ translate('tb.home.beforeYouStart', 'Before you start') }}
        </h3>
        <p class="govuk-body">
          {{ translate('tb.home.guidanceIntro', 'Read the guidance:') }}
          <a
            href="https://www.gov.uk/guidance/bovine-tb-get-your-cattle-tested-in-england"
            class="govuk-link"
          >
            {{ translate('tb.home.guidanceLinkText', 'Bovine TB: get your cattle tested in England') }}</a
          >.
        </p>
        <p class="govuk-body">
          {{ translate('tb.home.cannotProcessIf', 'APHA cannot process your application if:') }}
        </p>
        <ul class="govuk-list govuk-list--bullet">
          <li>
            {{ translate('tb.home.cannotProcessReasons.reason-1', 'reactors are still on your farm or premises') }}
          </li>
          <li>
            {{ translate('tb.home.cannotProcessReasons.reason-2', 'cattle are waiting for TB skin or blood test results') }}
          </li>
          <li>
            {{ translate('tb.home.cannotProcessReasons.reason-3', 'TB testing is overdue') }}
          </li>
        </ul>
        <p class="govuk-body">
          {{ translate('tb.home.contactVet', 'Contact your vet if you are unsure whether test results have been submitted. Delays may occur if APHA has not received them.') }}
        </p>
        <h3 class="govuk-heading-m">
          {{ translate('tb.home.whatYouNeedToApply', 'What you need to apply') }}
        </h3>
        <p class="govuk-body">
          {{ translate('tb.home.youWillNeed', 'You will need:') }}
        </p>
        <ul class="govuk-list govuk-list--bullet">
          <li>
            {{ translate('tb.home.requirements.requirement-1', 'the county parish holding (CPH) number and address cattle are moving from') }}
          </li>
          <li>
            {{ translate('tb.home.requirements.requirement-2', 'the CPH number and details of where the cattle are moving to (for example, the type of market)') }}
          </li>
          <li>
            {{ translate('tb.home.requirements.requirement-3', 'an email address you want the licence to go to') }}
          </li>
        </ul>
        <p class="govuk-body">
          {{ translate('tb.home.movingOntoFarm', 'If cattle are moving onto your farm, you must also:') }}
        </p>
        <ul class="govuk-list govuk-list--bullet">
          <li>
            {{ translate('tb.home.movingOntoFarmRequirements.requirement-1', 'provide details of your TB biosecurity procedures') }}
          </li>
          <li>
            {{ translate('tb.home.movingOntoFarmRequirements.requirement-2', 'upload a biosecurity map') }}
          </li>
        </ul>
        {{
          govukButton({ text: translate('common.startNow', 'Start now'), href:"task-list",
          isStartButton: true, attributes: "data-testid='start-now-btn'" })
        }}
        <p class="govuk-body">
          {{ translate('tb.home.applicationProcessingTime', 'Applications can take up to 5 working days to process.') }}
        </p>
        <p class="govuk-body">
          {{ translate('tb.home.processingDelay', 'It may take longer if veterinary checks are needed or if we need more information.') }}
        </p>
        <h3 class="govuk-heading-m">
          {{ translate('tb.home.getHelp', 'Get help') }}
        </h3>
        <p class="govuk-body">
          {{ translate('tb.home.callUs', 'Call 03000 200 301 and select the option for TB in animals.') }}
        </p>
        <p class="govuk-body">
          {{ translate('tb.home.openingHours', 'Lines are open Monday to Friday, 8:30am to 5pm.') }}
        </p>
      </div>
    </div>
  </div>
{% endblock %}
