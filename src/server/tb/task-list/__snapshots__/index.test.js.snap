exports[`TbTaskListController TbTaskListController should have the expected content 1`] = `
"
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        <h1 class="govuk-heading-l">Your Bovine Tuberculosis (TB) movement licence application</h1>
          <p>
            <span data="test-id-task-to-complete-count">
              You have 3 out of 3 sections left to complete.
            </span>
          </p>
        
<ul class="govuk-task-list">
  <li class="govuk-task-list__item govuk-task-list__item--with-link">
    <div class="govuk-task-list__name-and-hint">
      <a class="govuk-link govuk-task-list__link" href="/origin/to-or-from-own-premises" aria-describedby="task-list-1-status">
        Movement origin
      </a>
    </div>
    <div class="govuk-task-list__status" id="task-list-1-status">
      <strong class="govuk-tag govuk-tag--blue">
        Incomplete
      </strong>
    </div>
  </li>
  <li class="govuk-task-list__item">
    <div class="govuk-task-list__name-and-hint">
      <div>
        Movement destination
      </div>
    </div>
    <div class="govuk-task-list__status govuk-task-list__status--cannot-start-yet" id="task-list-2-status">
      Cannot start yet
    </div>
  </li>
  <li class="govuk-task-list__item">
    <div class="govuk-task-list__name-and-hint">
      <div>
        Receiving the licence
      </div>
    </div>
    <div class="govuk-task-list__status govuk-task-list__status--cannot-start-yet" id="task-list-3-status">
      Cannot start yet
    </div>
  </li>
</ul>

        <form method="POST">
          <input type="hidden" name="crumb" value="csrf-value"> <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">
  Review and submit
</button>
        </form>
      </div>
    </div>
  </div>
        "
`;

