{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% extends 'layouts/questions.njk' %}

{% block heading %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ heading }}</h1>
    </div>
  </div>
{% endblock %}

{% block beforequestion %}
  {% if disinfectant %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <p>
          {{
            translate(
              'tb.biosecurity.dilutionRate.page.intro',
              'By law you must use a Defra-approved disinfectant when there is an outbreak of TB. This includes using the correct dilution rate.'
            )
          }}
        </p>
        <p>
          {{
            translate(
              'tb.biosecurity.dilutionRate.page.approvedPrefix',
              'The approved dilution rate for'
            )
          }}
          {{ disinfectant }}
          {{ translate('tb.biosecurity.dilutionRate.page.is', 'is') if tr else 'is' }}
          {% if isUndiluted %}
            {{
              translate(
                'tb.biosecurity.dilutionRate.page.undiluted',
                'undiluted'
              )
            }}
          {% else %}
            1:{{ dilutionRate }}.
          {% endif %}
        </p>
        {% if not isUndiluted %}
          <p>
            {{
              translate(
                'tb.biosecurity.dilutionRate.page.explanationPrefix',
                'This means for every 1'
              )
            }}
            {{ disinfectantUnit }}
            {{
              translate(
                'tb.biosecurity.dilutionRate.page.explanationMiddle',
                'of'
              )
            }}
            {{ disinfectant }},
            {{
              translate(
                'tb.biosecurity.dilutionRate.page.explanationUsing',
                'you are using'
              )
            }}
            {{ dilutionRate }}
            {{ dilutantUnit }}
            {{
              translate(
                'tb.biosecurity.dilutionRate.page.explanationSuffix',
                'of water.'
              )
            }}
          </p>
        {% endif %}
      </div>
    </div>
  {% else %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <p>
          {{
            translate(
              'tb.biosecurity.dilutionRate.page.selectFirst',
              'You must select a disinfectant before confirming the dilution rate.'
            )
          }}
        </p>
      </div>
    </div>
  {% endif %}
{% endblock %}

{% block form %}
  {% if disinfectant %}
    {{ super() }}
  {% else %}
    {{
      govukButton({
        id: "continue-button",
        text: translate('tb.biosecurity.dilutionRate.page.selectDisinfectantButton', 'Select disinfectant') if tr else 'Select disinfectant',
        classes: continueButtonClasses,
        href: disinfectantUrl
      })
    }}
  {% endif %}
{% endblock %}
