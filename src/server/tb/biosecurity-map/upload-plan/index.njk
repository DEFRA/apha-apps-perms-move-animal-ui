{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "macros/create-summary.njk" import createSummary %}
{% from "uploadSpinner/macro.njk" import appUploadSpinner %}
{% extends 'layouts/questions.njk' %}
{% block heading %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ heading }}</h1>
    </div>
  </div>
{% endblock %}
{% block form %}
  <form
    method="POST"
    action="{{ upload.metadata.uploadUrl }}"
    novalidate
    enctype="multipart/form-data"
  >
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <input type="hidden" name="crumb" value="{{ crumb }}" />
        <input type="hidden" name="nextPage" value="{{ nextPage }}" />
        <p>
          {{ translate('tb.biosecurityMap.uploadPlan.intro', "You need to upload a map of the farm or premises.") }}
        </p>
        <p>
          {{ translate('tb.biosecurityMap.uploadPlan.preference', "We prefer a clear and detailed map, such as a Google map with annotations or a pre-prepared map from an agent or surveyor.") }}
        </p>
        <p>
          {{ translate('tb.biosecurityMap.uploadPlan.itNeedsToInclude', "It needs to include:") }}
        </p>
        <ul class="govuk-body govuk-list--bullet">
          <li>
            {{ translate('tb.biosecurityMap.uploadPlan.isolationLocation', "where the incoming cattle will be isolated") }}
          </li>
          <li>
            {{ translate('tb.biosecurityMap.uploadPlan.residentAndNeighbouringCattle', "location of the resident cattle and neighbouring cattle") }}
          </li>
          <li>
            {{ translate('tb.biosecurityMap.uploadPlan.minimumDistances', "minimum distances between the incoming cattle and any resident and neighbouring cattle") }}
          </li>
          <li>
            {{ translate('tb.biosecurityMap.uploadPlan.cattleMovements', "movements of the cattle, including where they will graze, be milked, and be loaded") }}
          </li>
          <li>
            {{ translate('tb.biosecurityMap.uploadPlan.handlingFacility', "location of handling facility") }}
          </li>
          <li>
            {{ translate('tb.biosecurityMap.uploadPlan.manureStorage', "location of manure or slurry storage") }}
          </li>
          <li>
            {{ translate('tb.biosecurityMap.uploadPlan.biosecurityPoints', "location of biosecurity points, including badger proof fencing") }}
          </li>
        </ul>
        <p>
          {{ translate('tb.biosecurityMap.uploadPlan.fileRequirements', "The selected file must be a PNG, JPEG, JPG or PDF and less than 10 MB.") }}
        </p>
        {{
          govukFileUpload
          ({
              id: "status.form.file",
              multiple: false,
              javascript: true,
              chooseFilesButtonText: translate('tb.biosecurityMap.uploadPlan.chooseFile', "Choose a file"),
              dropInstructionText: translate('tb.biosecurityMap.uploadPlan.dropFile', "or drop file"),
              enteredDropZoneText: translate('tb.biosecurityMap.uploadPlan.dropZoneEntered', "Entered drop zone"),
              leftDropZoneText: translate('tb.biosecurityMap.uploadPlan.dropZoneLeft', "Left drop zone"),
              noFileChosenText: translate('tb.biosecurityMap.uploadPlan.noFile', "No file chosen"),
              name: "file",
              label:{
                  text: translate('tb.biosecurityMap.uploadPlan.uploadFile', "Upload a file")
              },
              errorMessage: errors['status.form.file'],
              attributes: {
                "data-testid": "file-biosecuritymap-upload"
              }
          })
        }}
      </div>
    </div>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        {% block button %}
          {{
            govukButton({
              id: "continue-button",
              text: continueButtonText | default('Continue'),
              classes: continueButtonClasses | default('')
            })
          }}
        {% endblock %}
      </div>
    </div>
  </form>
  {{
    appUploadSpinner({
      title: "Uploading the biosecurity map",
      subTitle: "This may take a few minutes.",
      formPage: true
    })
  }}
{% endblock %}
{% block bodyEnd %}
  {{ super() }}
  <script
    type="module"
    src="{{ getAssetPath('file-upload-spinner.js') }}"
    nonce="{{uuid}}"
  ></script>
{% endblock %}
