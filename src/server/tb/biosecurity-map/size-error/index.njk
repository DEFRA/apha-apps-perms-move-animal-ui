{% from "govuk/components/button/macro.njk" import govukButton %}
{% extends 'layouts/questions.njk' %}
{% block beforequestion %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
      <div class="govuk-body" data-testid="app-page-body">
        <p>
          {{ translate('tb.biosecurityMap.sizeError.emailInstruction', 'You must email your biosecurity map to csc.tblicensing@apha.gov.uk') }}
        </p>
        <p>
          {{ translate('tb.biosecurityMap.sizeError.cphInstruction', 'In your email include your county parish holding (CPH) number.') }}
        </p>
        <p>
          {{ translate('tb.biosecurityMap.sizeError.processingNotice', 'Your application cannot be processed until we receive your biosecurity map.') }}
        </p>
      </div>
    </div>
  </div>
{% endblock %}
{% block questions %}
{% endblock %}
