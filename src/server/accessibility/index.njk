{%
  extends
  'layouts/page.njk'
%}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        <h1 class="govuk-heading-l">{{ heading }}</h1>
        <p class="govuk-body">
          {{ translate('common.accessibility.intro', 'Accessibility statement for Get permission to move animals under disease control.') }}
        </p>

        <h2 class="govuk-heading-m">
          {{ translate('common.accessibility.howToUseHeading', 'How you should be able to use this website') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.accessibility.howToUseIntro', 'We want as many people as possible to be able to use this website.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.accessibility.shouldBeAbleTo', 'You should be able to:') }}
        </p>
        <ul class="govuk-list govuk-list--bullet">
          <li>
            {{ translate('common.accessibility.changeColours', 'Change colours, contrast levels and fonts using browser or device settings') }}
          </li>
          <li>
            {{ translate('common.accessibility.zoom', 'Zoom in up to 200% without the text spilling off the screen') }}
          </li>
          <li>
            {{ translate('common.accessibility.keyboard', 'Navigate most of the website using a keyboard or speech recognition software') }}
          </li>
          <li>
            {{
              translate('common.accessibility.screenReader', 'Listen to most of the website using a screen reader (including the
              most recent versions of JAWS, NVDA and VoiceOver)')
            }}
          </li>
          <li>
            {{ translate('common.accessibility.simpleText', 'We also make the website text as simple as possible to understand') }}
          </li>
        </ul>

        <h2 class="govuk-heading-m">
          {{ translate('common.accessibility.accessibilityHeading', 'How accessible this website is') }}
        </h2>
        <p class="govuk-body">
          {{
            translate('common.accessibility.accessibilityBody', 'While most of this website is fully accessible, we are engaging in a
            full accessibility audit that may uncover unknown accessibility
            issues. If you encounter any, please')
          }}
          <a
            data-testid="feedback-link"
            target="_blank"
            class="govuk-link"
            href="https://defragroup.eu.qualtrics.com/jfe/form/SV_7ZDFNwIA2wLF9lk"
            >{{ translate('common.accessibility.feedbackLink', 'give your feedback (opens in new tab)') }}
          </a>
          {{ translate('common.accessibility.feedbackSuffix', 'to let us know how we can improve.') }}
        </p>
      </div>
    </div>
  </div>
{% endblock %}
