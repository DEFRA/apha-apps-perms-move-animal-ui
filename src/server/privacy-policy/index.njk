{% extends 'layouts/page.njk' %}

{% block content %}
  {%
    set abbreviationTitles = {
      APHA: translate('common.privacy.aphaAbbreviationTitle', 'Animal and Plant Health Agency'),
      GDPR: translate('common.privacy.gdprAbbreviationTitle', 'General Data Protection Regulation')
    }
  %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        <h1 class="govuk-heading-l">{{ heading }}</h1>
        <p class="govuk-body">
          {{ translate('common.privacy.intro', 'The privacy notice covers all of Animal and Plant Health Agency’s work.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.moreInformation', 'More detailed information on how we manage personal data for each of our functions is included within') }}
          <a
            href="https://www.gov.uk/government/publications/animal-and-plant-health-agency-privacy-notices"
            class="govuk-link"
            >{{ translate('common.privacy.individualPrivacyNotices', 'individual privacy notices') }}</a
          >.
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.dataCollectedByHeading', 'Your data is being collected by') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.dataController', 'The data controller is the Department for Environment, Food and Rural Affairs (Defra) for personal data that you give to the Animal and Plant Health Agency (APHA).') | formatAbbreviations(abbreviationTitles) }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.aphaDataProtectionManager', 'APHA is an Executive Agency of Defra. You can contact APHA’s Data Protection Manager by email at:') | formatAbbreviations(abbreviationTitles) }}
          <a href="mailto:data.protection@defra.gov.uk" class="govuk-link"
            >{{ translate('common.privacy.dataProtectionEmail', 'data.protection@defra.gov.uk') }}</a
          >.
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.jointControllers', 'APHA also works with the Scottish Government and Welsh Government, who are joint controllers with APHA for any relevant personal data.') | formatAbbreviations(abbreviationTitles) }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.dataQuestions', 'Any questions about how Defra and APHA are using your personal data and your associated rights should be sent to the above contact.') | formatAbbreviations(abbreviationTitles) }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.dataProtectionOfficer', 'The Data Protection Officer responsible for monitoring that Defra and APHA is meeting the requirements of the legislation can be contacted by email at:') | formatAbbreviations(abbreviationTitles) }}
          <a
            href="mailto:defragroupdataprotectionofficer@defra.gov.uk"
            class="govuk-link"
            >{{ translate('common.privacy.dataProtectionOfficerEmail', 'DefraGroupDataProtectionOfficer@defra.gov.uk') }}</a
          >.
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.dataCollectedHeading', 'What personal data is collected') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.dataCollectedIntro', 'The personal data collected is made clear in') }}
          <a
            href="https://www.gov.uk/government/publications/animal-and-plant-health-agency-privacy-notices"
            class="govuk-link"
            >{{ translate('common.privacy.dataCollectedLinkText', 'individual APHA privacy notices') | formatAbbreviations(abbreviationTitles) }}</a
          >
          {{ translate('common.privacy.dataCollectedSuffix', 'or documentation that collects personal data.') }}
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.dataObtainedHeading', 'How your data has been obtained') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.dataObtainedIntro', 'We have obtained your data either directly from you or a third party. How your data has been obtained in any particular case is made clear in') }}
          <a
            href="https://www.gov.uk/government/publications/animal-and-plant-health-agency-privacy-notices"
            class="govuk-link"
            >{{ translate('common.privacy.dataObtainedLinkText', 'individual APHA privacy notices') | formatAbbreviations(abbreviationTitles) }}</a
          >
          {{ translate('common.privacy.dataObtainedSuffix', 'or documentation that collects personal data.') }}
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.whyDataHeading', 'Why APHA is using your data') | formatAbbreviations(abbreviationTitles) }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.whyDataIntro', 'Personal data is collected and stored to support APHA’s functions which include:') | formatAbbreviations(abbreviationTitles) }}
        </p>
        <ul class="govuk-list govuk-list--bullet">
          <li>
            {{ translate('common.privacy.functions.function-1', 'identifying and controlling endemic and exotic diseases and pests in animals, plants and bees, and surveillance of new and emerging pests and diseases') }}
          </li>
          <li>
            {{ translate('common.privacy.functions.function-2', 'scientific research') }}
          </li>
          <li>
            {{ translate('common.privacy.functions.function-3', 'facilitating international trade in animals, products of animal origin, and plants') }}
          </li>
          <li>
            {{ translate('common.privacy.functions.function-4', 'protecting endangered wildlife through licensing and registration') }}
          </li>
          <li>
            {{ translate('common.privacy.functions.function-5', 'safeguard animal health and welfare; and protect human health where relevant (zoonoses)') }}
          </li>
          <li>
            {{ translate('common.privacy.functions.function-6', 'managing a programme of bee inspections, diagnostics, research and development, and training and advice') }}
          </li>
          <li>
            {{ translate('common.privacy.functions.function-7', 'regulating the safe disposal of animal by-products to reduce the risk of potentially dangerous substances entering the food chain') }}
          </li>
          <li>
            {{ translate('common.privacy.functions.function-8', 'employee data necessary to support staff management') }}
          </li>
          <li>
            {{ translate('common.privacy.functions.function-9', 'the safeguarding of employees, sub-contractors and customers (this may include very limited use of body worn video when necessary)') }}
          </li>
          <li>
            {{ translate('common.privacy.functions.function-10', 'for APHA’s statutory functions in relation to plant biosecurity; the environmental release of genetically modified organisms; and in the management of alien and invasive species - specifically for notifiable pests and diseases, imports and export controls, training and for statutory food safety monitoring purposes') | formatAbbreviations(abbreviationTitles) }}
          </li>
        </ul>
        <p class="govuk-body">
          {{ translate('common.privacy.moreAboutApha', 'More information about APHA can be found at') | formatAbbreviations(abbreviationTitles) }}
          <a href="http://www.gov.uk/apha" class="govuk-link"
            >{{ translate('common.privacy.aphaWebsite', 'www.gov.uk/apha') }}</a
          >.
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.googleAnalyticsHeading', 'Your data and Google Analytics') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.googleAnalyticsIntro', 'Our website uses Google Analytics, a web analytics service provided by Google, to monitor site activity and gather insights into how users interact with our content.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.googleAnalyticsData', 'This data allows us to understand user behaviour better and implement improvements to enhance your experience on our site. As part of this process, Google Analytics collects certain information, including your IP address. This data helps us determine approximate locations, enabling us to identify potential areas for user research and better tailor our services to meet users’ needs.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.googleAnalyticsPurpose', 'Please note that the information collected is used solely for analytical and improvement purposes.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.googleAnalyticsPrivacy', 'We respect your privacy and are committed to handling your data responsibly. For more information on how Google collects and processes data, please refer to') }}
          <a href="https://policies.google.com/" class="govuk-link"
            >{{ translate('common.privacy.googlePrivacyLink', 'Google’s Privacy & Terms') }}</a
          >.
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.legalBasisHeading', 'The legal basis for processing your data') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.legalBasisIntro', 'Legal bases for processing include:') }}
        </p>
        <ul class="govuk-list govuk-list--bullet">
          <li>
            {{ translate('common.privacy.legalBases.legalBase-1', 'the performance of a task carried out in the public interest or in the exercise of official authority vested in the controller') }}
          </li>
          <li>
            {{ translate('common.privacy.legalBases.legalBase-2', 'for compliance to a legal obligation on the controller') }}
          </li>
          <li>
            {{ translate('common.privacy.legalBases.legalBase-3', 'the performance of a contract to which the data subject is party or in order to take steps at the request of the data subject prior to entering a contract') }}
          </li>
          <li>
            {{ translate('common.privacy.legalBases.legalBase-4', 'you have given us consent to process your data for one or more specified purposes') }}
          </li>
        </ul>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.consentHeading', 'Consent to process your data') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.consent', 'Where the legal basis for processing your personal data is your consent, you can opt out at any time and details of how you can do that are made available to you by the team that is processing your personal data.') }}
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.requirementHeading', 'A legal or contractual requirement to provide personal data') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.requirement', 'Sometimes you are legally or contractually required to share personal data by APHA. These situations are made clear in the relevant privacy notices.') | formatAbbreviations(abbreviationTitles) }}
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.consequencesHeading', 'Consequences of not providing the necessary data') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.consequences.consequence-1', 'For statutory and public interest purposes it is necessary to provide data as stated in the relevant legislation.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.consequences.consequence-2', 'For contractual based processing, your entrance into a contract with us is voluntary and necessary information is supplied to fulfil that contractual relationship.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.consequences.consequence-3', 'For consent based processing you have a right to revoke this at any given time.') }}
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.automatedDecisionHeading', 'Personal data used for automated decision making') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.automatedDecision', 'The information you provide is not connected with individual decision making, in other words making a decision solely by automated means without any human involvement.') }}
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.profilingHeading', "Personal data fused or automated 'profiling' and the consequences of this") }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.profiling', 'The information you provide is not connected with profiling, in other words automated processing of personal data to evaluate certain things about an individual.') }}
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.sharingHeading', 'Who APHA shares your data with') | formatAbbreviations(abbreviationTitles) }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.sharing.sharing-1', 'Personal data may be made available to local authorities and other public bodies in the UK and EU to meet legal requirements and regulatory and enforcement functions.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.sharing.sharing-2', 'We may share data with Defra and its agencies, Welsh Government, Scottish Government, Northern Ireland Executive, Food Standards Agency and other official organisations and enforcement authorities.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.sharing.sharing-3', 'We may share data with other organisations working for us to enable us to carry out our duties.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.sharing.sharing-4', 'We may have to release information (including personal data and commercial information) under the following legislation:') }}
        </p>
        <ul class="govuk-list govuk-list--bullet">
          <li>
            {{ translate('common.privacy.legislation.legislation-1', 'UK General Data Protection Regulation (UK GDPR)') | formatAbbreviations(abbreviationTitles) }}
          </li>
          <li>
            {{ translate('common.privacy.legislation.legislation-2', 'UK Data Protection Act 2018') }}
          </li>
          <li>
            {{ translate('common.privacy.legislation.legislation-3', 'Freedom of Information Act 2000') }}
          </li>
          <li>
            {{ translate('common.privacy.legislation.legislation-4', 'Environmental Information Regulations 2004') }}
          </li>
        </ul>
        <p class="govuk-body">
          {{ translate('common.privacy.confidentiality', 'We will not allow any unwarranted breach of confidentiality and we will not act in contravention of our obligations under UK data protection legislation.') }}
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.outsideUkHeading', 'Storing and using personal data outside the UK') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.outsideUk.outsideUk-1', 'A very small percentage of government records containing personal information are selected for permanent preservation at the National Archives. They are made available in accordance with the Freedom of Information Act 2000, as amended by the Data Protection Act 2018.') }}
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.outsideUk.outsideUk-2', 'The data you provide will largely not be transferred outside of the UK. On rare occasions, when it is lawful and complementary to our work carried out in the public interest, research data may be transferred securely outside of the UK.') }}
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.retentionHeading', 'How long APHA holds personal data for') | formatAbbreviations(abbreviationTitles) }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.retention', 'All information with APHA is held in accordance with our retention policy, if you would like more information please contact') | formatAbbreviations(abbreviationTitles) }}
          <a href="mailto:enquiries@apha.gov.uk" class="govuk-link"
            >{{ translate('common.privacy.enquiriesEmail', 'enquiries@apha.gov.uk') }}</a
          >.
        </p>
        <p class="govuk-body">
          {{ translate('common.privacy.longerRetention', 'In specific circumstances information may be held for longer periods. Examples include:') }}
        </p>
        <ul class="govuk-list govuk-list--bullet">
          <li>
            {{ translate('common.privacy.longerRetentionExamples.longerRetentionExample-1', 'appeal') }}
          </li>
          <li>
            {{ translate('common.privacy.longerRetentionExamples.longerRetentionExample-2', 'audit activity') }}
          </li>
          <li>
            {{ translate('common.privacy.longerRetentionExamples.longerRetentionExample-3', 'complaint') }}
          </li>
          <li>
            {{ translate('common.privacy.longerRetentionExamples.longerRetentionExample-4', 'irregularity') }}
          </li>
          <li>
            {{ translate('common.privacy.longerRetentionExamples.longerRetentionExample-5', 'legal action') }}
          </li>
          <li>
            {{ translate('common.privacy.longerRetentionExamples.longerRetentionExample-6', 'a formal request for information') }}
          </li>
          <li>
            {{ translate('common.privacy.longerRetentionExamples.longerRetentionExample-7', 'if it sets a precedent') }}
          </li>
          <li>
            {{ translate('common.privacy.longerRetentionExamples.longerRetentionExample-8', 'scientific or historical research purposes') }}
          </li>
        </ul>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.rightsHeading', 'Your rights') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.rightsIntro', 'Find out about') }}
          <a
            href="https://ico.org.uk/for-organisations/guide-to-the-general-data-protection-regulation-gdpr/individual-rights/"
            class="govuk-link"
            >{{ translate('common.privacy.rightsLink', 'your rights under data protection law') }}</a
          >.
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.complaintsHeading', 'Complaints') }}
        </h2>
        <p class="govuk-body">
          {{ translate('common.privacy.complaints', 'You have the right to lodge a complaint about the use of your personal data at any time with') }}
          <a href="https://ico.org.uk/make-a-complaint/" class="govuk-link"
            >{{ translate('common.privacy.icoLink', 'Information Commissioner’s Office') }}</a
          >
          {{ translate('common.privacy.complaintsSuffix', '(ICO - the data protection supervisory authority).') }}
        </p>
        <h2 class="govuk-heading-m">
          {{ translate('common.privacy.charterHeading', 'APHA’s personal information charter') }}
        </h2>
        <p class="govuk-body">
          <a
            href="https://www.gov.uk/government/organisations/animal-and-plant-health-agency/about/personal-information-charter"
            class="govuk-link"
            >{{ translate('common.privacy.charterLink', 'APHA’s personal information charter') | formatAbbreviations(abbreviationTitles) }}</a
          >
          {{ translate('common.privacy.charterText', 'APHA processes personal data.') | formatAbbreviations(abbreviationTitles) }}
        </p>
      </div>
    </div>
  </div>
{% endblock %}
